# .env.local.example
# Copiar a .env.local en desarrollo.
# .env.local es ignorado por .gitignore y nunca se versionará.

# Valores locales/privados específicos de tu ambiente que .env.example no debería tener:

# PIDE Real URLs (si trabajas con desarrollo real)
# PIDE_URL_RENIEC=https://ws1.pide.gob.pe/Rest/RENIEC/Consultar?out=json
# PIDE_URL_SUNAT=https://ws1.pide.gob.pe/Rest/Sunat/RucPersona?out=json
# PIDE_URL_SUNARP=https://ws1.pide.gob.pe/Rest/Sunarp/DniMarcaReal?out=json
# PIDE_URL_CCOACTIVA=https://ws1.pide.gob.pe/Rest/CCoactiva/ObtenerDatos?out=json
# PIDE_URL_CAMBIENTALES=https://ws1.pide.gob.pe/Rest/CAmbientales/ConsultarFicha?out=json
# PIDE_URL_MTC=https://ws3.pide.gob.pe/Rest/Mtc
# PIDE_URL_CONADIS=https://ws2.pide.gob.pe/Rest/CONADIS/PDiscapacidad
# PIDE_URL_UPDATE=https://ws5.pide.gob.pe/Rest/Pide/PCM/Update
# PIDE_URL_RENIEC_UPDATE=https://ws2.pide.gob.pe/Rest/RENIEC/Actualizar

# PIDE Credenciales usuario (si conexión real en desarrollo):
# PIDE_SUNARP_USUARIO=tu_usuario
# PIDE_SUNARP_PASS=tu_password_real

# Valores reales de aplicación (nunca en repo público):
# DB_PASSWORD=tu_contraseña_db_real
# DB_HOST=ip_o_dominio_privado
# AWS_SECRET_ACCESS_KEY=...
# MAIL_PASSWORD=...
